{
  "pipeline": [
    {
      "type": "readers.las",
      "filename": "INPUT_2024_LIDAR.laz"
    },
    {
      "type": "filters.assign",
      "value": "Classification = 0"
    },
    {
      "type": "filters.smrf",
      "window": 16.0,
      "slope": 0.15,
      "threshold": 0.5,
      "scalar": 1.25
    },
    {
      "type": "writers.las",
      "filename": "OUTPUT_2024_LIDAR_SMRF.las",
      "forward": "all",
      "extra_dims": "all"
    }
  ]
}
